SLACK_APP_TOKEN=xapp-replace-me
SLACK_BOT_TOKEN=xoxb-replace-me
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.moonshot.cn/v1
OPENAI_MODEL=kimi-k2.6
# Kimi Chat Completions currently accepts system/user/assistant only. This is
# an explicit, trace-visible authority downgrade; use native for providers that
# support the developer role.
OPENAI_DEVELOPER_ROLE_MODE=system-fallback
# OPENAI_FALLBACK_MODELS=fallback-model
# Optional multi-provider model runtime. When this file exists it replaces the
# legacy OPENAI_* profile; copy docs/models.example.json to this path first.
# PIBOT_MODELS_CONFIG=.pibot/models.json
# PIBOT_MODELS_STORE=.pibot/models-store.json
# PIBOT_MODEL=anthropic/claude-opus-5
# PIBOT_FALLBACK_MODELS=openai/gpt-5.6-sol
# ANTHROPIC_API_KEY=replace-me
# Optional fast model dedicated to semantic WebUI session titles.
# PIBOT_TITLE_MODEL=deepseek-chat
# Retry cooldown after two empty/failed title attempts.
PIBOT_TITLE_EMPTY_RETRY_MS=300000
MODEL_MAX_RETRIES=2
MODEL_RETRY_BASE_DELAY_MS=500
MODEL_RETRY_MAX_DELAY_MS=8000
# Optional override. Without it PIBot uses the smallest known context window
# across configured/cached selectable models, or 262144 when none is known.
# MODEL_CONTEXT_WINDOW_TOKENS=262144
AGENT_MAX_STEPS=80
AGENT_MAX_PARALLEL_TOOL_CALLS=8

SESSION_COMPACTION_RESERVE_TOKENS=32768
SESSION_COMPACTION_KEEP_RECENT_TOKENS=20000
SESSION_COMPACTION_MAX_OVERFLOW_RETRIES=1
SESSION_MAX_MEMORY_INDEX_FILE_BYTES=8000
SESSION_MAX_MEMORY_FILE_BYTES=64000
SESSION_MAX_MEMORY_AUDIT_FILE_BYTES=2000000
SESSION_MAX_MEMORY_USAGE_FILE_BYTES=2000000
SESSION_MAX_MEMORY_CURATION_JOB_FILE_BYTES=256000
# Run-end curation is enabled by default. Extraction only stages a candidate;
# a separate consolidation pass may accept low-risk reusable knowledge.
MEMORY_CURATION_ENABLED=true
MEMORY_CURATION_MAX_OUTPUT_TOKENS=5000
MEMORY_CURATION_MAX_EVIDENCE_CHARS=30000
MEMORY_CURATION_TIMEOUT_MS=60000
# Optional maintenance key used only by `npm run memory:backfill`.
# MEMORY_BACKFILL_TEAM_ID=memory-maintenance
# MEMORY_BACKFILL_CHANNEL_ID=historical-backfill

# Optional comma-separated Skill names:
# SKILLS_DISABLED=legacy-release,experimental-refactor
SKILLS_MAX_COUNT=100
SKILLS_MAX_FILE_BYTES=64000

WORKSPACE_ROOT=.
PIBOT_STORE_ROOT=.pibot
PIBOT_TRACE_MAX_FILE_BYTES=20000000

# Optional WebUI control plane:
# PIBOT_WEBUI_ENABLED=1
# Listen on every interface in the Linux environment. The browser URL is
# usually http://127.0.0.1:8787 through VS Code/SSH port forwarding from Windows.
# PIBOT_WEBUI_HOST=0.0.0.0
# PIBOT_WEBUI_PORT=8787
# Set this only if you access WebUI through a fixed direct host URL.
# PIBOT_WEBUI_PUBLIC_URL=http://<your-host>:8787
# Runtime-code self-evolution activation button is enabled by default.
# With `npm run webui`, activation restarts in the original terminal.
# PIBOT_EVOLUTION_RESTART_ENABLED=1
# PIBOT_EVOLUTION_RESTART_MARKER=.pibot/runtime-activation/restart-request.json
# PIBOT_EVOLUTION_RESTART_COMMAND=sudo systemctl restart pibot
# PIBOT_EVOLUTION_RESTART_LABEL=systemd restart
# PIBOT_EVOLUTION_RESTART_DELAY_MS=1500

SANDBOX_EXECUTOR=linux-native
TOOL_APPROVAL_MODE=workspace-write
TOOL_APPROVAL_TIMEOUT_MS=300000
# Full Tool Results are archived first; only the model-facing copy is bounded.
TOOL_RESULT_CONTEXT_THRESHOLD_CHARS=8192
TOOL_RESULT_CONTEXT_HEAD_CHARS=4096
TOOL_RESULT_CONTEXT_TAIL_CHARS=1024

# Optional: defaults to CHILD_AGENT_MAX_TOOL_CALLS when unset.
# CHILD_AGENT_MAX_STEPS=40

# Optional linux-native overrides:
# SANDBOX_LINUX_LAUNCHER_PATH=./native/bin/pibot-linux-sandbox
# SANDBOX_LINUX_MAX_PROCESSES=256
# SANDBOX_LINUX_MAX_OPEN_FILES=256
# SANDBOX_LINUX_MAX_FILE_SIZE_BYTES=64000000
# SANDBOX_LINUX_MAX_MEMORY_BYTES=17179869184

# Optional Docker executor instead of linux-native:
# SANDBOX_EXECUTOR=docker
# SANDBOX_DOCKER_CONTAINER=pibot-sandbox
# SANDBOX_DOCKER_WORKSPACE_ROOT=/workspace
